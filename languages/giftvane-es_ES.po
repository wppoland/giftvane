#. Plugin Name of the plugin
#: giftvane.php
msgid "Giftvane - Gift Cards and Store Credit for WooCommerce"
msgstr ""

#. Plugin URI of the plugin
#: giftvane.php
msgid "https://plogins.com/giftvane/"
msgstr ""

#. Description of the plugin
#: giftvane.php
msgid ""
"Sell gift cards that email a redeemable code to the recipient and apply as a "
"discount at checkout."
msgstr ""
"Venda tarjetas de regalo que envíen por correo electrónico un código "
"canjeable al destinatario y se apliquen como descuento al finalizar la "
"compra."

#. Author of the plugin
#: giftvane.php
msgid "WPPoland.com"
msgstr ""

